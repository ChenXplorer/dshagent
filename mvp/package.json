{
  "name": "dshagent-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/dsh-host",
    "apps/multi-tenant-gateway",
    "packages/dsh-loop",
    "packages/dsh-trajectory",
    "packages/tenant-control",
    "packages/dsh-hub-control",
    "deploy/daytona"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "postinstall": "node apps/dsh-host/patch-session.mjs . && node apps/dsh-host/patch-loop-primitives.mjs .",
    "test": "tsx --test packages/**/*.test.ts apps/**/*.test.ts deploy/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start:tenant-gateway": "tsx apps/multi-tenant-gateway/start.ts",
    "provision:user": "tsx apps/multi-tenant-gateway/provision-user.ts",
    "provision:tenant-workspaces": "tsx deploy/multica/provision-tenant-workspaces.ts",
    "onboard:tenant": "tsx deploy/onboarding/onboard-tenant.ts",
    "verify:tenant-fleet": "tsx deploy/dsh-hub/verify-tenant-fleet.ts"
  },
  "dependencies": {
    "@daytona/sdk": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "pnpm": "12.4.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
