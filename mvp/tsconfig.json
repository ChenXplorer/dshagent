{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "deploy/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "**/node_modules", "**/dist"]
}
