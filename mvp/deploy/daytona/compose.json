{
  "name": "dshagent-daytona",
  "services": {
    "api": {
      "image": "daytonaio/daytona-api@sha256:8de6315a378430a58a44ce6c20b41050c2f602446e75f3ff559edbaa0b3758a7",
      "ports": [
        "127.0.0.1:33000:3000"
      ],
      "environment": {
        "OTEL_ENABLED": "false",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://otel-collector:4318",
        "DEFAULT_SNAPSHOT": "daytonaio/sandbox:0.5.0-slim",
        "ENCRYPTION_KEY": "${DAYTONA_ENCRYPTION_KEY:?required}",
        "ENCRYPTION_SALT": "${DAYTONA_ENCRYPTION_SALT:?required}",
        "NODE_ENV": "production",
        "PORT": "3000",
        "DB_HOST": "db",
        "DB_PORT": "5432",
        "DB_USERNAME": "user",
        "DB_PASSWORD": "${DAYTONA_DB_PASSWORD:?required}",
        "DB_DATABASE": "daytona",
        "REDIS_HOST": "redis",
        "REDIS_PORT": "6379",
        "OIDC_CLIENT_ID": "daytona",
        "OIDC_ISSUER_BASE_URL": "http://dex:5556/dex",
        "PUBLIC_OIDC_DOMAIN": "http://localhost:35556/dex",
        "OIDC_AUDIENCE": "daytona",
        "OIDC_MANAGEMENT_API_ENABLED": "",
        "OIDC_MANAGEMENT_API_CLIENT_ID": "",
        "OIDC_MANAGEMENT_API_CLIENT_SECRET": "",
        "OIDC_MANAGEMENT_API_AUDIENCE": "",
        "DASHBOARD_URL": "http://localhost:33000/dashboard",
        "DASHBOARD_BASE_API_URL": "http://localhost:33000",
        "POSTHOG_API_KEY": "",
        "POSTHOG_HOST": "https://d18ag4dodbta3l.cloudfront.net",
        "POSTHOG_ENVIRONMENT": "local",
        "TRANSIENT_REGISTRY_URL": "http://registry:6000",
        "TRANSIENT_REGISTRY_ADMIN": "admin",
        "TRANSIENT_REGISTRY_PASSWORD": "${DAYTONA_REGISTRY_PASSWORD:?required}",
        "TRANSIENT_REGISTRY_PROJECT_ID": "daytona",
        "INTERNAL_REGISTRY_URL": "http://registry:6000",
        "INTERNAL_REGISTRY_ADMIN": "admin",
        "INTERNAL_REGISTRY_PASSWORD": "${DAYTONA_REGISTRY_PASSWORD:?required}",
        "INTERNAL_REGISTRY_PROJECT_ID": "daytona",
        "SMTP_HOST": "maildev",
        "SMTP_PORT": "1025",
        "SMTP_USER": "",
        "SMTP_PASSWORD": "",
        "SMTP_SECURE": "",
        "SMTP_EMAIL_FROM": "Daytona Team <no-reply@daytona.io>",
        "S3_ENDPOINT": "http://minio:9000",
        "S3_STS_ENDPOINT": "http://minio:9000/minio/v1/assume-role",
        "S3_REGION": "us-east-1",
        "S3_ACCESS_KEY": "${DAYTONA_MINIO_USER:?required}",
        "S3_SECRET_KEY": "${DAYTONA_MINIO_PASSWORD:?required}",
        "S3_DEFAULT_BUCKET": "daytona",
        "S3_ACCOUNT_ID": "/",
        "S3_ROLE_NAME": "/",
        "ENVIRONMENT": "docker-compose",
        "MAX_AUTO_ARCHIVE_INTERVAL": "43200",
        "MAINTENANCE_MODE": "false",
        "PROXY_DOMAIN": "proxy.localhost:34000",
        "PROXY_TOOLBOX_BASE_URL": "http://localhost:34000",
        "PROXY_PROTOCOL": "http",
        "PROXY_API_KEY": "${DAYTONA_PROXY_KEY:?required}",
        "PROXY_TEMPLATE_URL": "http://{{PORT}}-{{sandboxId}}.proxy.localhost:34000",
        "DEFAULT_RUNNER_DOMAIN": "runner:3003",
        "DEFAULT_RUNNER_API_URL": "http://runner:3003",
        "DEFAULT_RUNNER_PROXY_URL": "http://runner:3003",
        "DEFAULT_RUNNER_API_KEY": "${DAYTONA_RUNNER_KEY:?required}",
        "DEFAULT_RUNNER_CPU": "4",
        "DEFAULT_RUNNER_MEMORY": "4",
        "DEFAULT_RUNNER_DISK": "40",
        "DEFAULT_RUNNER_NAME": "default",
        "DEFAULT_REGION_ID": "us",
        "DEFAULT_REGION_NAME": "us",
        "DEFAULT_REGION_ENFORCE_QUOTAS": "false",
        "DEFAULT_ORG_QUOTA_TOTAL_CPU_QUOTA": "10000",
        "DEFAULT_ORG_QUOTA_TOTAL_MEMORY_QUOTA": "10000",
        "DEFAULT_ORG_QUOTA_TOTAL_DISK_QUOTA": "100000",
        "DEFAULT_ORG_QUOTA_MAX_CPU_PER_SANDBOX": "100",
        "DEFAULT_ORG_QUOTA_MAX_MEMORY_PER_SANDBOX": "100",
        "DEFAULT_ORG_QUOTA_MAX_DISK_PER_SANDBOX": "1000",
        "DEFAULT_ORG_QUOTA_SNAPSHOT_QUOTA": "1000",
        "DEFAULT_ORG_QUOTA_MAX_SNAPSHOT_SIZE": "1000",
        "DEFAULT_ORG_QUOTA_VOLUME_QUOTA": "10000",
        "SSH_GATEWAY_API_KEY": "${DAYTONA_SSH_KEY:?required}",
        "SSH_GATEWAY_COMMAND": "ssh -p 2222 {{TOKEN}}@localhost",
        "SSH_GATEWAY_URL": "localhost:2222",
        "RUNNER_DECLARATIVE_BUILD_SCORE_THRESHOLD": "10",
        "RUNNER_AVAILABILITY_SCORE_THRESHOLD": "${DAYTONA_RUNNER_AVAILABILITY_SCORE_THRESHOLD:-10}",
        "RUNNER_START_SCORE_THRESHOLD": "3",
        "SKIP_USER_EMAIL_VERIFICATION": "true",
        "RUN_MIGRATIONS": "true",
        "OTEL_COLLECTOR_API_KEY": "otel_collector_api_key",
        "HEALTH_CHECK_API_KEY": "${DAYTONA_HEALTH_KEY:?required}"
      },
      "networks": [
        "daytona-network"
      ],
      "restart": "unless-stopped",
      "privileged": true,
      "depends_on": [
        "db",
        "runner",
        "redis",
        "dex",
        "registry"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "mem_limit": "1536m"
    },
    "proxy": {
      "image": "daytonaio/daytona-proxy@sha256:63834f0477e154f92de8d44efb0809dffbd2392c188b6cf41dac94ed8ade26c2",
      "environment": {
        "DAYTONA_API_URL": "http://api:3000/api",
        "PROXY_PORT": "4000",
        "PROXY_API_KEY": "${DAYTONA_PROXY_KEY:?required}",
        "PROXY_PROTOCOL": "http",
        "OIDC_CLIENT_ID": "daytona",
        "OIDC_CLIENT_SECRET": "",
        "OIDC_DOMAIN": "http://dex:5556/dex",
        "OIDC_PUBLIC_DOMAIN": "http://localhost:35556/dex",
        "OIDC_AUDIENCE": "daytona",
        "REDIS_HOST": "redis",
        "REDIS_PORT": "6379",
        "TOOLBOX_ONLY_MODE": "false",
        "PREVIEW_WARNING_ENABLED": "false"
      },
      "networks": [
        "daytona-network"
      ],
      "ports": [
        "127.0.0.1:34000:4000"
      ],
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "runner": {
      "image": "daytonaio/daytona-runner@sha256:3253f4fdfda80bfc3b13e9e7ddf022cb5412dca94230371091e16cd0860427e0",
      "environment": {
        "ENVIRONMENT": "development",
        "API_PORT": "3003",
        "DAYTONA_RUNNER_TOKEN": "${DAYTONA_RUNNER_KEY:?required}",
        "LOG_FILE_PATH": "/home/daytona/runner/runner.log",
        "RESOURCE_LIMITS_DISABLED": "true",
        "AWS_ENDPOINT_URL": "http://minio:9000",
        "AWS_REGION": "us-east-1",
        "AWS_ACCESS_KEY_ID": "${DAYTONA_MINIO_USER:?required}",
        "AWS_SECRET_ACCESS_KEY": "${DAYTONA_MINIO_PASSWORD:?required}",
        "AWS_DEFAULT_BUCKET": "daytona",
        "DAYTONA_API_URL": "http://api:3000/api",
        "RUNNER_DOMAIN": "runner",
        "SSH_GATEWAY_ENABLE": "false",
        "INTER_SANDBOX_NETWORK_ENABLED": "false",
        "BUILD_CPU_CORES": "2",
        "BUILD_MEMORY_GB": "3",
        "HTTP_PROXY": "${DAYTONA_RUNNER_HTTP_PROXY:-}",
        "HTTPS_PROXY": "${DAYTONA_RUNNER_HTTP_PROXY:-}",
        "NO_PROXY": "localhost,127.0.0.1,api,runner,registry,minio,db,redis,dex,10.203.0.0/24,172.20.0.0/16"
      },
      "networks": [
        "daytona-network"
      ],
      "privileged": true,
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "volumes": [
        "${DAYTONA_STATE_DIR:?required}/runner-docker:/var/lib/docker",
        "${DAYTONA_STATE_DIR:?required}/runner-state:/home/daytona/runner"
      ],
      "mem_limit": "5g",
      "cpus": 4
    },
    "dex": {
      "image": "dexidp/dex@sha256:1b4a6eee8550240b0faedad04d984ca939513650e1d9bd423502c67355e3822f",
      "volumes": [
        "${DAYTONA_DEX_CONFIG:?required}:/etc/dex/config.yaml:ro",
        "${DAYTONA_STATE_DIR:?required}/dex:/var/dex"
      ],
      "entrypoint": [
        "sh",
        "-c",
        "touch /var/dex/dex.db && exec dex serve /etc/dex/config.yaml"
      ],
      "networks": [
        "daytona-network"
      ],
      "ports": [
        "127.0.0.1:35556:5556"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "--spider",
          "--quiet",
          "http://localhost:5556/dex/.well-known/openid-configuration"
        ]
      },
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "db": {
      "image": "postgres@sha256:4ef4dbc939d61acea57712655ddb4b4ab27419c913f94cca0cd57cb3ea3c2280",
      "environment": {
        "POSTGRES_PASSWORD": "${DAYTONA_DB_PASSWORD:?required}",
        "POSTGRES_USER": "user",
        "POSTGRES_DB": "daytona"
      },
      "networks": [
        "daytona-network"
      ],
      "volumes": [
        "${DAYTONA_STATE_DIR:?required}/postgres:/var/lib/postgresql/18/docker"
      ],
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "mem_limit": "512m"
    },
    "redis": {
      "image": "redis@sha256:f773b35a95e170d92dd4214a3ec4859b1b7960bf56896ae687646d695f311187",
      "networks": [
        "daytona-network"
      ],
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "command": [
        "redis-server",
        "--appendonly",
        "yes"
      ],
      "volumes": [
        "${DAYTONA_STATE_DIR:?required}/redis:/data"
      ],
      "mem_limit": "256m"
    },
    "registry": {
      "image": "registry@sha256:bcece5dd3d4b6189e13e7ac71b2ccbc2aae649365f0c589852d687efeba6b290",
      "restart": "unless-stopped",
      "environment": {
        "REGISTRY_HTTP_HEADERS_Access-Control-Allow-Origin": "[http://registry-ui.example.com]",
        "REGISTRY_HTTP_HEADERS_Access-Control-Allow-Methods": "[HEAD,GET,OPTIONS,DELETE]",
        "REGISTRY_HTTP_HEADERS_Access-Control-Allow-Credentials": "[true]",
        "REGISTRY_HTTP_HEADERS_Access-Control-Allow-Headers": "[Authorization,Accept,Cache-Control]",
        "REGISTRY_HTTP_HEADERS_Access-Control-Expose-Headers": "[Docker-Content-Digest]",
        "REGISTRY_STORAGE_DELETE_ENABLED": "true",
        "REGISTRY_HTTP_ADDR": "registry:6000"
      },
      "volumes": [
        "${DAYTONA_STATE_DIR:?required}/registry:/var/lib/registry"
      ],
      "networks": [
        "daytona-network"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "minio": {
      "image": "${DAYTONA_MINIO_IMAGE:?pin a verified MinIO image digest}",
      "environment": {
        "MINIO_ROOT_USER": "${DAYTONA_MINIO_USER:?required}",
        "MINIO_ROOT_PASSWORD": "${DAYTONA_MINIO_PASSWORD:?required}",
        "MINIO_IDENTITY_STS_EXPIRY": "\"24h\""
      },
      "volumes": [
        "${DAYTONA_STATE_DIR:?required}/minio:/data"
      ],
      "command": "server /data --console-address \":9001\"",
      "networks": [
        "daytona-network"
      ],
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    }
  },
  "networks": {
    "daytona-network": {
      "external": true,
      "name": "${DAYTONA_DOCKER_NETWORK:?required}"
    }
  }
}
