# Current MVP: Hub is private and loopback-only. There is no Cloudflare/OIDC
# or end-user authentication in this phase. Keep the copied .env private.
DSH_HUB_PUBLIC_ORIGIN=http://127.0.0.1:18090
DSH_HUB_OPERATOR_EMAILS=mock-operator@local.invalid
DSH_HUB_ORIGIN_SECRET=replace-with-at-least-32-random-characters
DSH_HUB_INTERNAL_AUTH=true
DSH_HUB_INTERNAL_OPERATOR_TOKEN=replace-with-an-internal-operator-token-at-least-32-chars
DSH_HUB_INTERNAL_NODE_ID=node-lab.access
DSH_HUB_INTERNAL_NODE_SECRET=replace-with-an-internal-node-secret-at-least-32-chars

# Set an immutable digest for production. The default tag is only a bootstrap
# convenience and must be reviewed before it is exposed outside a lab.
DSH_HUB_IMAGE=dsh-hub:1.0.4-reviewed
# This target already uses loopback:8080; choose a free loopback port.
DSH_HUB_BIND_PORT=18090

# The compose template builds the exact pinned upstream checkout when an
# immutable image is not supplied. The target Ubuntu runs a separate rootless
# Docker data-root under /home, so the named Hub volumes are stored there.
DSH_HUB_SOURCE=/home/dev/dsh-hub
