new file mode 100644
index 0000000..a529d9d
--- /dev/null
+++ b/server/internal/daemon/transcriptoutbox/store.go
@@ -0,0 +1,187 @@
+// Package transcriptoutbox durably retries the official daemon transcript API.
+package transcriptoutbox
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"sync"
+)
+
+type Envelope struct {
+	TaskID   string          `json:"task_id"`
+	Messages json.RawMessage `json:"messages"`
+}
+
+// Store contains no credentials. Identity scopes a spool to one server/daemon.
+type Store struct {
+	dir string
+	mu  sync.Mutex
+}
+
+func New(root, identity string) *Store {
+	sum := sha256.Sum256([]byte(identity))
+	return &Store{dir: filepath.Join(root, ".transcript-outbox", hex.EncodeToString(sum[:16]))}
+}
+
+// Persist syncs before publishing a .json file; replay never reads partial data.
+func (s *Store) Persist(taskID string, messages json.RawMessage) (string, error) {
+	if taskID == "" || !json.Valid(messages) {
+		return "", errors.New("invalid transcript envelope")
+	}
+	data, err := json.Marshal(Envelope{TaskID: taskID, Messages: messages})
+	if err != nil {
+		return "", err
+	}
+	digest := sha256.Sum256(data)
+	name := hex.EncodeToString(digest[:]) + ".json"
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := os.MkdirAll(s.dir, 0700); err != nil {
+		return "", err
+	}
+	path := filepath.Join(s.dir, name)
+	if previous, err := os.ReadFile(path); err == nil {
+		if !bytes.Equal(previous, data) {
+			return "", errors.New("transcript digest conflict")
+		}
+		return path, nil
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return "", err
+	}
+	f, err := os.CreateTemp(s.dir, ".pending-")
+	if err != nil {
+		return "", err
+	}
+	tmp := f.Name()
+	defer os.Remove(tmp)
+	if err = f.Chmod(0600); err == nil {
+		_, err = f.Write(data)
+	}
+	if err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err != nil {
+		return "", err
+	}
+	if closeErr != nil {
+		return "", closeErr
+	}
+	if err = os.Rename(tmp, path); err != nil {
+		return "", err
+	}
+	if err = syncDir(s.dir); err != nil {
+		return "", err
+	}
+	return path, nil
+}
+
+func syncDir(path string) error {
+	// Windows does not support directory fsync through os.File; the target
+	// deployment is Linux, where both data and directory entries are synced.
+	if runtime.GOOS == "windows" {
+		return nil
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	return f.Sync()
+}
+
+type Sender func(context.Context, Envelope) error
+
+func (s *Store) Deliver(ctx context.Context, path string, send Sender) error {
+	if filepath.Dir(path) != s.dir || !strings.HasSuffix(path, ".json") {
+		return errors.New("invalid transcript path")
+	}
+	data, err := os.ReadFile(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	} // Another ACK already removed it.
+	if err != nil {
+		return err
+	}
+	var envelope Envelope
+	if err = json.Unmarshal(data, &envelope); err != nil {
+		return err
+	}
+	if envelope.TaskID == "" || !json.Valid(envelope.Messages) {
+		return errors.New("invalid pending transcript")
+	}
+	if err = send(ctx, envelope); err != nil {
+		return err
+	}
+	if err = os.Remove(path); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	return syncDir(s.dir)
+}
+
+// Drain retries independent tasks even if one task returns a permanent error.
+// Files are never silently discarded because an HTTP status is non-retryable.
+func (s *Store) Drain(ctx context.Context, send Sender) error {
+	entries, err := os.ReadDir(s.dir)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	var failures []error
+	for _, entry := range entries {
+		if err := ctx.Err(); err != nil {
+			return errors.Join(append(failures, err)...)
+		}
+		if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".json") {
+			continue
+		}
+		if err := s.Deliver(ctx, filepath.Join(s.dir, entry.Name()), send); err != nil {
+			failures = append(failures, fmt.Errorf("pending transcript: %w", err))
+		}
+	}
+	return errors.Join(failures...)
+}
+
+// Pending reports durable batches by task, including completed/cancelled tasks.
+func (s *Store) Pending() (map[string]int, error) {
+	result := map[string]int{}
+	entries, err := os.ReadDir(s.dir)
+	if errors.Is(err, os.ErrNotExist) {
+		return result, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	for _, entry := range entries {
+		if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".json") {
+			continue
+		}
+		data, err := os.ReadFile(filepath.Join(s.dir, entry.Name()))
+		if errors.Is(err, os.ErrNotExist) {
+			continue
+		}
+		if err != nil {
+			return nil, err
+		}
+		var envelope Envelope
+		if err = json.Unmarshal(data, &envelope); err != nil {
+			return nil, err
+		}
+		if envelope.TaskID == "" || !json.Valid(envelope.Messages) {
+			return nil, errors.New("invalid pending transcript")
+		}
+		result[envelope.TaskID]++
+	}
+	return result, nil
+}
