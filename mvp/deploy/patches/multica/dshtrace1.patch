+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/multica-ai/multica/server/internal/daemon/transcriptoutbox"
+)
+
+func TestTranscriptClientRetainsFailedBatchAndReplaysWithCallID(t *testing.T) {
+	var attempts atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var body struct {
+			Messages []TaskMessageData `json:"messages"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Error(err)
+		}
+		if len(body.Messages) != 1 || body.Messages[0].CallID != "genuine-call-id" {
+			t.Errorf("bad body: %+v", body)
+		}
+		if attempts.Add(1) == 1 {
+			http.Error(w, "temporary outage", 503)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		w.Write([]byte(`{"status":"ok"}`))
+	}))
+	defer server.Close()
+	root := t.TempDir()
+	client := NewClient(server.URL)
+	client.transcriptOutbox = transcriptoutbox.New(root, server.URL)
+	if err := client.ReportTaskMessages(context.Background(), "task", []TaskMessageData{{Seq: 1, Type: "tool_use", CallID: "genuine-call-id", Tool: "shell"}}); err == nil {
+		t.Fatal("expected temporary error")
+	}
+	client = NewClient(server.URL)
+	client.transcriptOutbox = transcriptoutbox.New(root, server.URL)
+	if err := client.transcriptOutbox.Drain(context.Background(), client.transcriptSender); err != nil {
+		t.Fatal(err)
+	}
+	if pending, err := client.transcriptOutbox.Pending(); err != nil || len(pending) != 0 {
+		t.Fatalf("pending=%v err=%v", pending, err)
+	}
+	if attempts.Load() != 2 {
+		t.Fatalf("attempts=%d", attempts.Load())
+	}
+}
+
+func TestTranscriptEveryConstructedDaemonHasPersistentOutbox(t *testing.T) {
+	d := New(Config{ServerBaseURL: "http://localhost:18080", WorkspacesRoot: t.TempDir(), DaemonID: "personal"}, slog.New(slog.NewTextHandler(os.Stderr, nil)))
+	if d.client.transcriptOutbox == nil {
+		t.Fatal("production daemon must not use non-durable direct API path")
+	}
+}
+
+func TestTranscriptHealthExposesTaskOwnershipAndPendingTail(t *testing.T) {
+	d := New(Config{ServerBaseURL: "http://localhost:18080", WorkspacesRoot: t.TempDir(), DaemonID: "personal"}, slog.New(slog.NewTextHandler(os.Stderr, nil)))
+	d.activeTaskIDs = map[string]struct{}{"still-running": {}}
+	d.claimsInFlight = 1
+	if _, err := d.client.transcriptOutbox.Persist("finished-with-pending-tail", json.RawMessage(`[{"seq":1}]`)); err != nil {
+		t.Fatal(err)
+	}
+	request := httptest.NewRequest(http.MethodGet, "/health", nil)
+	response := httptest.NewRecorder()
+	d.healthHandler(time.Now()).ServeHTTP(response, request)
+	var health HealthResponse
+	if err := json.Unmarshal(response.Body.Bytes(), &health); err != nil {
+		t.Fatal(err)
+	}
+	if health.ClaimsInFlight != 1 || len(health.ActiveTaskIDs) != 1 || health.ActiveTaskIDs[0] != "still-running" {
+		t.Fatalf("ownership missing: %+v", health)
+	}
+	if health.TranscriptOutboxError || health.TranscriptPendingByTask["finished-with-pending-tail"] != 1 {
+		t.Fatalf("pending delivery hidden: %+v", health)
+	}
+}
