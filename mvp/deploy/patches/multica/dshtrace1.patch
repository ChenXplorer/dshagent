+package transcriptoutbox
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+)
+
+func TestReplayAfterCommittedResponseLostAndRestart(t *testing.T) {
+	root := t.TempDir()
+	store := New(root, "server\ndaemon")
+	path, err := store.Persist("task", json.RawMessage(`[{"seq":1,"type":"tool_use","call_id":"cli-real-call-id"}]`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	committed := map[string]bool{}
+	attempts := 0
+	send := func(_ context.Context, envelope Envelope) error {
+		attempts++
+		committed[envelope.TaskID+string(envelope.Messages)] = true
+		if attempts == 1 {
+			return errors.New("response lost after server commit")
+		}
+		return nil
+	}
+	if err := store.Deliver(context.Background(), path, send); err == nil {
+		t.Fatal("expected uncertain acknowledgement")
+	}
+	store = New(root, "server\ndaemon")
+	if pending, err := store.Pending(); err != nil || pending["task"] != 1 {
+		t.Fatalf("pending=%v err=%v", pending, err)
+	}
+	if err := store.Drain(context.Background(), send); err != nil {
+		t.Fatal(err)
+	}
+	if attempts != 2 || len(committed) != 1 {
+		t.Fatalf("attempts=%d committed=%d", attempts, len(committed))
+	}
+	if pending, err := store.Pending(); err != nil || len(pending) != 0 {
+		t.Fatalf("pending=%v err=%v", pending, err)
+	}
+}
+
+func TestConcurrentTasksPersistIndependently(t *testing.T) {
+	store := New(t.TempDir(), "server\ndaemon")
+	var wg sync.WaitGroup
+	for _, taskID := range []string{"codex-a", "codex-b"} {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if _, err := store.Persist(taskID, json.RawMessage(`[{"seq":1,"type":"text","content":"working"}]`)); err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	wg.Wait()
+	err := store.Drain(context.Background(), func(_ context.Context, envelope Envelope) error {
+		if envelope.TaskID == "codex-a" {
+			return errors.New("temporarily offline")
+		}
+		return nil
+	})
+	if err == nil {
+		t.Fatal("expected retained failure")
+	}
+	pending, err := store.Pending()
+	if err != nil || pending["codex-a"] != 1 || pending["codex-b"] != 0 {
+		t.Fatalf("pending=%v err=%v", pending, err)
+	}
+}
+
+func TestRepeatedPersistAndPrivateFilePermissions(t *testing.T) {
+	store := New(t.TempDir(), "server\ndaemon")
+	payload := json.RawMessage(`[{"seq":2,"type":"tool_result","output_truncated":true}]`)
+	one, err := store.Persist("task", payload)
+	if err != nil {
+		t.Fatal(err)
+	}
+	two, err := store.Persist("task", payload)
+	if err != nil || one != two {
+		t.Fatalf("one=%s two=%s err=%v", one, two, err)
+	}
+	info, err := os.Stat(one)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Mode().Perm()&0077 != 0 && os.PathSeparator != '\\' {
+		t.Fatal("transcript exposed to other users")
+	}
+	if _, err := New(filepath.Dir(filepath.Dir(store.dir)), "another-server").Pending(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestWriteFailureAndCorruptEnvelopeAreVisible(t *testing.T) {
+	root := t.TempDir()
+	block := filepath.Join(root, "file-not-directory")
+	if err := os.WriteFile(block, []byte("blocked"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := New(block, "server").Persist("task", json.RawMessage(`[]`)); err == nil {
+		t.Fatal("write failure must propagate")
+	}
+	store := New(root, "server")
+	path, err := store.Persist("task", json.RawMessage(`[]`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte("corrupt"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := store.Pending(); err == nil {
+		t.Fatal("corrupt pending record must remain visible")
+	}
+	if err := store.Drain(context.Background(), func(context.Context, Envelope) error { t.Fatal("must not send corrupt data"); return nil }); err == nil {
+		t.Fatal("expected corruption error")
+	}
+	if _, err := os.Stat(path); err != nil {
+		t.Fatal("failed records must not be deleted")
+	}
+}
