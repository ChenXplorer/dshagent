+package handler
+
+import (
+	"context"
+	"net/http"
+	"testing"
+
+	"github.com/multica-ai/multica/server/internal/testutil"
+	"github.com/multica-ai/multica/server/internal/util"
+)
+
+func TestReportTaskMessagesRetryIsIdempotentAndPreservesCallID(t *testing.T) {
+	if testHandler == nil {
+		t.Skip("database not available; requires migrations 478 and 479")
+	}
+	taskID := seedBatchTask(t, "transcript-idempotency")
+	messages := []any{
+		map[string]any{"seq": 1, "type": "tool_use", "tool": "shell", "call_id": "real-a", "input": map[string]any{"command": "pwd"}},
+		map[string]any{"seq": 2, "type": "tool_use", "tool": "shell", "call_id": "real-b", "input": map[string]any{"command": "ls"}},
+		map[string]any{"seq": 3, "type": "tool_result", "tool": "shell", "call_id": "real-b", "output": "files"},
+		map[string]any{"seq": 4, "type": "tool_result", "tool": "shell", "call_id": "real-a", "output": "/workspace"},
+	}
+	for range 2 {
+		testutil.Call(t, testHandler.ReportTaskMessages, batchMessagesRequest(t, taskID, messages)).Want(http.StatusOK)
+	}
+	stored, err := testHandler.Queries.ListTaskMessages(context.Background(), util.MustParseUUID(taskID))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(stored) != 4 {
+		t.Fatalf("retry stored %d rows, expected four unique sequences", len(stored))
+	}
+	for index, want := range []string{"real-a", "real-b", "real-b", "real-a"} {
+		if stored[index].CallID.String != want {
+			t.Fatalf("row %d lost call ID: %+v", index, stored[index])
+		}
+		if got := taskMessageToPayload(stored[index], taskID, "").CallID; got != want {
+			t.Fatalf("public payload call ID=%q want=%q", got, want)
+		}
+	}
+}
