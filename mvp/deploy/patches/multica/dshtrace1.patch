new file mode 100644
index 0000000..c6ecf5f
--- /dev/null
+++ b/server/internal/daemon/transcript_outbox.go
@@ -0,0 +1,63 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"github.com/multica-ai/multica/server/internal/daemon/transcriptoutbox"
+	"github.com/multica-ai/multica/server/pkg/redact"
+)
+
+type TranscriptPersistenceError struct{ Err error }
+
+func (e *TranscriptPersistenceError) Error() string {
+	return "persist task transcript: " + e.Err.Error()
+}
+func (e *TranscriptPersistenceError) Unwrap() error { return e.Err }
+
+func (c *Client) transcriptSender(ctx context.Context, envelope transcriptoutbox.Envelope) error {
+	sendCtx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	return c.postJSON(sendCtx, fmt.Sprintf("/api/daemon/tasks/%s/messages", envelope.TaskID), map[string]any{
+		"messages": envelope.Messages,
+	}, nil)
+}
+
+func (c *Client) reportDurableTaskMessages(ctx context.Context, taskID string, messages []TaskMessageData) error {
+	redacted := make([]TaskMessageData, len(messages))
+	for i, message := range messages {
+		message.Content = redact.Text(message.Content)
+		message.Output = redact.Text(message.Output)
+		message.Input = redact.InputMap(message.Input)
+		redacted[i] = message
+	}
+	payload, err := json.Marshal(redacted)
+	if err != nil {
+		return &TranscriptPersistenceError{Err: err}
+	}
+	path, err := c.transcriptOutbox.Persist(taskID, payload)
+	if err != nil {
+		return &TranscriptPersistenceError{Err: err}
+	}
+	return c.transcriptOutbox.Deliver(ctx, path, c.transcriptSender)
+}
+
+func (d *Daemon) transcriptReplayLoop(ctx context.Context) {
+	ticker := time.NewTicker(2 * time.Second)
+	defer ticker.Stop()
+	for {
+		drainCtx, cancel := context.WithTimeout(ctx, 30*time.Second)
+		err := d.client.transcriptOutbox.Drain(drainCtx, d.client.transcriptSender)
+		cancel()
+		if err != nil && ctx.Err() == nil {
+			d.logger.Warn("task transcript delivery pending", "error", err)
+		}
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+		}
+	}
+}
